doctype html
html
  head
    title= title
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 Cars
    a(href="/update-cobj") Add / Update Car
    if records && records.length
      table(border="1", cellpadding="8")
        thead
          tr
            th Name
        tbody
          each item in records
            tr
              td= item.properties.name
    else
      p No cars yet.
